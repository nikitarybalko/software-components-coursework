@startuml component
!include style.iuml
skinparam componentStyle uml2
title Діаграма компонентів Wargame Broker

package "Клієнти" {
    component "Симулятор Blue Force\n<<Python, Mesa>>" as BlueSim
    component "Симулятор Red Force\n<<Python, Mesa>>" as RedSim
    component "Дашборд Командира\n<<Next.js>>" as Dashboard {
        component "Інтерфейс\n<<React>>" as DashboardUi
        component "API-проксі\n/api/simulation" as DashboardProxy
    }
}

component "Wargame Broker\n<<Spring Boot>>" as Broker {

    portin "HTTP :8080" as RestPort

    package "Веб-шар" {
        component "ApiKeyAuthFilter" as AuthFilter
        component "RoleAuthorization\nInterceptor" as RoleInterceptor
        component "Контролери REST\nSimulator, Tick,\nSimulation, State" as Controllers
        component "GlobalException\nHandler" as ErrorHandler
        component "Swagger UI\n(OpenAPI)" as Swagger
    }

    package "Ядро предметної області" {
        interface "SimulationSessionService" as ISession
        interface "TickManager" as ITick
        interface "SimulatorRegistry" as IRegistry
        interface "FogOfWarService" as IFog
        interface "StateCheckpointingService" as ICheckpoint

        component "SimulationSession\nServiceImpl" as Session
        component "BarrierTickManager" as TickManager
        component "InMemorySimulator\nRegistry" as Registry
        component "EuclideanFogOf\nWarService" as Fog
    }

    component "SimulationTimeout\nScheduler" as Scheduler

    package "Інфраструктура збереження" {
        component "JpaStateCheckpointing\nService" as Checkpointing
        component "Spring Data JPA\nSnapshotRepository,\nEventLogRepository" as Repositories
    }
}

database "PostgreSQL 16" as Db {
    collections "snapshots,\nsnapshot_units" as SnapshotTables
    collections "event_logs" as EventTables
}

BlueSim --> RestPort : REST /api/v1\nключ Blue
RedSim --> RestPort : REST /api/v1\nключ Red
DashboardUi --> DashboardProxy : HTTP
DashboardProxy --> RestPort : REST /api/v1\nключ адміністратора

RestPort --> AuthFilter : /api/**
RestPort --> Swagger : /swagger-ui,\n/v3/api-docs
AuthFilter --> RoleInterceptor : роль клієнта
RoleInterceptor --> Controllers
Controllers ..> ErrorHandler : винятки

Session -up- ISession
TickManager -up- ITick
Registry -up- IRegistry
Fog -up- IFog
Checkpointing -up- ICheckpoint

Controllers ..> ISession
Controllers ..> ITick
Controllers ..> ICheckpoint
Scheduler ..> ITick : перевірка тайм-ауту\nщосекунди
Session ..> ITick
Session ..> IRegistry
Session ..> ICheckpoint
TickManager ..> IFog : O(N × M)
TickManager ..> IRegistry
TickManager ..> ICheckpoint : зліпки, події

Checkpointing --> Repositories
Repositories --> SnapshotTables : JDBC
Repositories --> EventTables : JDBC

note right of Checkpointing
  Інтерфейс оголошено в ядрі, реалізацію надає
  інфраструктура: ядро не залежить від JPA і БД.
end note

@enduml
