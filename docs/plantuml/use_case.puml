@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor LightCyan
    BorderColor DarkSlateGray
    ArrowColor DimGray
}

actor "Адміністратор\n(користувач)" as Admin
actor "Симулятор\n(Blue/Red Force)" as Sim

rectangle "Мікросервіс Варгейм-брокер" {

    rectangle "Підсистема керування сесією" {
        usecase "UC-2: Керувати життєвим циклом симуляції" as UC2
        
        usecase "UC-2.1: Ініціалізувати / Скинути (Reset)" as UC2_1
        usecase "UC-2.2: Відновити симуляцію" as UC2_2
        usecase "UC-2.3: Призупинити (тайм-аут)" as UC2_3
        
        usecase "UC-2.2.1: Завантажити зліпок з БД" as UC2_2_1
        
        UC2_1 .up.> UC2 : <<extend>>
        UC2_2 .up.> UC2 : <<extend>>
        UC2_3 .up.> UC2 : <<extend>>
        
        UC2_2 ..> UC2_2_1 : <<include>>
    }

    rectangle "Підсистема обміну даними (Tick)" {
        usecase "UC-1: Обмінятися даними кроку" as UC1
        
        usecase "UC-1.1: Автентифікувати клієнта" as UC1_1
        usecase "UC-1.2: Провалидувати JSON" as UC1_2
        usecase "UC-1.3: Розрахувати видимість" as UC1_3
        usecase "UC-1.4: Зберегти стан у БД" as UC1_4
        
        usecase "UC-1.2.1: Помилка 400 Bad Request" as UC1_2_1
        usecase "UC-1.3.1: Зменшити радіус огляду" as UC1_3_1
        usecase "UC-1.4.1: Створити глобальний зліпок" as UC1_4_1
        usecase "UC-1.4.2: Залогувати критичну подію" as UC1_4_2
        
        UC1 ..> UC1_1 : <<include>>
        UC1 ..> UC1_2 : <<include>>
        UC1 ..> UC1_3 : <<include>>
        UC1 ..> UC1_4 : <<include>>
        
        UC1_2_1 .up.> UC1_2 : <<extend>>
        UC1_3_1 .up.> UC1_3 : <<extend>>
        UC1_4_1 .up.> UC1_4 : <<extend>>
        UC1_4_2 .up.> UC1_4 : <<extend>>
    }
}

Admin --> UC2
Sim --> UC2
Sim --> UC1

@enduml